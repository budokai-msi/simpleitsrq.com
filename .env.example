# simpleitsrq-web — required env vars
#
# Copy this file to .env.local for local development and fill in the values.
# Production values live in the Vercel dashboard:
#   https://vercel.com/dashboard → simpleitsrq-com → Settings → Environment Variables
#
# Several of these are provisioned automatically when you run:
#   vercel integration add neon
#   vercel env pull .env.local --yes
#
# Never commit .env.local — it's already in .gitignore.
#
# =====================================================================
#   SENSITIVITY MARKINGS (Vercel env-var types)
# =====================================================================
# The April 2026 Vercel breach decrypted every non-"Sensitive"-typed
# env var for affected projects. Going forward, every row below marked
# [SENSITIVE] MUST be added to Vercel with the Sensitive toggle ON.
# See SECURITY.md at the repo root for the full incident writeup +
# rotation runbook.
#
#   [SENSITIVE]  → secret; mark Sensitive in Vercel, rotate if leaked
#   [PUBLIC]     → VITE_* prefix; shipped to the client bundle by
#                  design — safe to leave non-sensitive
#   [PUBLIC-OK]  → technically secret but low-impact if leaked
# =====================================================================

# --- Resend (transactional email) ---  [SENSITIVE]
# Sends the contact form payload to hello@simpleitsrq.com.
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# --- Cloudflare Turnstile (captcha) ---  [SENSITIVE] (secret) + [PUBLIC] (site key)
# Server-side secret used to verify submission tokens.
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000

# Public site key used by the Turnstile widget in the browser.
# The VITE_ prefix exposes it to the client bundle — this key IS meant to be public.
VITE_TURNSTILE_SITE_KEY=0x0000000000000000000000000000000000000000

# --- Contact inbox destination (optional) ---
# Overrides the "to" address for contact form and ticket submissions.
# Defaults to hello@simpleitsrq.com. Set to a real mailbox (e.g. a Gmail
# address) until the apex MX records for simpleitsrq.com are configured.
# CONTACT_TO_EMAIL=you@example.com

# --- Reply-by-email (Cloudflare Email Worker) ---  [SENSITIVE]
# Lets customers reply to a ticket email and have it thread back onto the
# ticket. Free path via Cloudflare Email Routing (apex MX is already Cloudflare):
#   1. Deploy cloudflare/email-worker.js as an Email Worker and set it as the
#      Email Routing catch-all action.
#   2. Set INBOUND_SHARED_SECRET below to a random string, and set the SAME
#      value as the Worker's INBOUND_SECRET variable.
# The Worker posts ticket replies to /api/portal?action=inbound-email with this
# secret in the x-inbound-secret header; the server verifies it constant-time.
# Without this, outbound + portal replies still work; only inbound email
# threading is disabled.
INBOUND_SHARED_SECRET=replace_with_a_long_random_string
# Domain the reply-to addresses live on. Default: simpleitsrq.com (apex, where
# Cloudflare Email Routing receives). Only set this if you move inbound.
# INBOUND_EMAIL_DOMAIN=simpleitsrq.com
# Optional dedicated HMAC key for signing reply addresses + .ics tokens.
# Falls back to AUTH_SECRET when unset, which is fine for most deployments.
# TICKET_MAIL_SECRET=replace_with_random_32_bytes_base64url
#
# Alternative inbound path (paid Resend plan): set RESEND_WEBHOOK_SECRET instead
# and point a Resend Inbound webhook at the same endpoint. The handler supports
# both; the Cloudflare Worker path takes precedence when x-inbound-secret is sent.
# RESEND_WEBHOOK_SECRET=whsec_your_signing_secret_here

# --- Cal.com inline booking (public) ---
# Full Cal.com path in the form "handle/event-slug".
# Dashboard: https://app.cal.com/event-types
# Example: simpleitsrq/free-consultation
# The VITE_ prefix exposes it to the client bundle — this value IS public.
# Leave empty until you finish Cal.com setup; the /book page will show a
# "coming soon" placeholder with an email fallback.
VITE_CALCOM_CAL_LINK=

# --- Neon Postgres (client portal DB) ---
# Provisioned automatically by:
#   vercel integration add neon
# You get DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED + a bunch of
# POSTGRES_* / PG* aliases. The portal code reads DATABASE_URL.
# Apply the schema with:
#   node --env-file=.env.local scripts/db/push.mjs
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# [SENSITIVE] Rotate the role password in Neon Console if exposed.

# --- Session signing ---  [SENSITIVE]
# Random 32-byte base64url secret, used to sign session cookies / CSRF state.
# Rotating AUTH_SECRET invalidates every live signed-in session — that's
# the desired behavior post-compromise.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace_with_random_32_bytes_base64url

# --- Canonical app URL ---
# Used when building OAuth redirect_uri. Production should set it explicitly.
# If unset, the server only accepts known deployment origins
# and otherwise falls back to https://simpleitsrq.com.
#   Local dev:   http://localhost:3000
#   Production:  https://simpleitsrq.com
APP_URL=https://simpleitsrq.com

# --- Google OAuth client ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# App type: Web application.
# Authorized redirect URI:
#   https://simpleitsrq.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google    (add for local dev)
GOOGLE_CLIENT_ID=your_google_client_id_here
# [SENSITIVE]
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Auth0 Universal Login (enterprise SSO — Okta, Azure AD, Ping, etc.) ---
# Auth0 Application → Settings → Basic Information.
# Application type: Regular Web Application.
# Allowed Callback URLs:
#   https://simpleitsrq.com/api/auth/callback/auth0
#   http://localhost:3000/api/auth/callback/auth0    (add for local dev)
# Allowed Logout URLs:
#   https://simpleitsrq.com/portal
#   http://localhost:3000/portal    (add for local dev)
#
# To connect Okta specifically:
#   1. In Auth0 dashboard → Authentication → Enterprise → Okta → Create Connection
#   2. Enter your Okta domain (e.g. yourcompany.okta.com)
#   3. Set AUTH0_CONNECTION=okta below (or leave empty for Universal Login page)
AUTH0_CLIENT_ID=
# [SENSITIVE]
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=your-tenant.auth0.com
# Optional: pin to a specific IdP connection (e.g. "okta", "azure-ad").
# Leave empty to show Auth0 Universal Login with all enabled connections.
# AUTH0_CONNECTION=okta

# --- GitHub OAuth app ---
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App.
# Homepage URL:           https://simpleitsrq.com
# Authorization callback: https://simpleitsrq.com/api/auth/callback/github
# (Create a second app for localhost if you want to test OAuth locally.)
GITHUB_CLIENT_ID=
# [SENSITIVE]
GITHUB_CLIENT_SECRET=

# --- GitHub content publishing (fine-grained PAT) ---
# Blog drafts produced by the cron agent are published by committing to
# src/data/posts.js via the GitHub Contents API. Needs a fine-grained
# personal access token scoped to the simpleitsrq.com repo with
# "Contents: read and write" permission.
# Create at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
# [SENSITIVE] Prefer a fine-grained token scoped to this single repo
# with only "Contents: read and write" — not a classic or full-scope PAT.

# --- Admin contact ---
# Email that receives operational alerts (cron failures, security events,
# new orphan tickets backfilled on sign-in). It does NOT grant admin access;
# owner authorization is hard-locked by a server-side identity digest.
ADMIN_EMAIL=you@example.com
ADMIN_EMAILS=

# --- Groq API key (guarded Hacker News blog engine) ---
# Powers the daily cron that rewrites one relevant Hacker News story into
# a local Simple IT SRQ field note. The cron auto-publishes only when
# title/meta/link/slop/banned-offer guardrails pass; otherwise it leaves
# the row in draft_posts for review at /portal?tab=drafts.
# Dashboard: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# --- Anthropic API key (security analysis only) ---
# Powers the optional daily security-analysis email. Blog generation no
# longer uses Anthropic.
# Dashboard: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here
# [SENSITIVE] This one bills real money. Set a hard spending limit in
# the Anthropic dashboard alongside rotation.

# --- Cron secret ---  [SENSITIVE]
# Shared secret verified by api/cron/* handlers. Vercel's cron scheduler
# passes it in the Authorization: Bearer <CRON_SECRET> header. Random
# 32-byte base64url value — generate with the same command as AUTH_SECRET.
CRON_SECRET=replace_with_random_32_bytes_base64url

# --- Stripe (invoice pipeline + payment links) ---  [SENSITIVE]
# LIVE mode secret key — the portal uses a two-step draft → review → send
# flow so no invoice is finalized without an explicit admin click.
# Rotating mid-cycle: Stripe honors old keys for a 7-day grace period,
# but inspect the last 90 days of events before disabling the old key.
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_key_here

# Public Leadgen Stripe Payment Links. The client app appends the LAUNCH20
# promo code unless a link already includes its own prefilled_promo_code.
VITE_LEADGEN_GROWTH_MONTHLY_URL=https://buy.stripe.com/8x2cMYaAX3qg648aUlak01y
VITE_LEADGEN_GROWTH_ANNUAL_URL=https://buy.stripe.com/9B65kwgZl4uk9gk7I9ak01z
VITE_LEADGEN_PRO_MONTHLY_URL=https://buy.stripe.com/14A8wI5gDbWM0JO9Qhak01A
VITE_LEADGEN_PRO_ANNUAL_URL=https://buy.stripe.com/4gM28kaAX1i8eAE0fHak01B


# --- Affiliate program IDs (VITE_ prefix exposes to client bundle) ---
# Only the ones with values will render links and show the FTC disclosure.
# Each maps to an entry in src/data/affiliates.js.
# Amazon Associates:
VITE_AFF_AMAZON_TAG=
# Gusto Payroll referral URL (e.g. https://gusto.com/r/yourcode):
VITE_AFF_GUSTO_REF=
# 1Password Business (PartnerStack):
VITE_AFF_1PASSWORD_REF=
# HoneyBook referral URL:
VITE_AFF_HONEYBOOK_REF=
# Acronis MSP partner link:
VITE_AFF_ACRONIS_REF=
# Ubiquiti UniFi Partner Program landing URL — drives the camera buyer's guide
# and any UniFi gear mention. Sign up: https://www.ui.com/partner-program/
VITE_AFF_UBNT_REF=
# Reolink affiliate (Impact) landing URL — drives the residential / Tier-1
# camera tier in the buyer's guide. Sign up: https://reolink.com/affiliate/
VITE_AFF_REOLINK_REF=
# B&H Photo Pro Affiliate — drives any AV / pro-networking gear that's
# better-priced at B&H than at Amazon. Sign up: https://bhphotovideo.com/affiliates
VITE_AFF_BH_REF=
# Backblaze Cloud Backup — drives the post-repair "set up off-machine backup"
# cross-sell. Sign up: https://www.backblaze.com/affiliates/
VITE_AFF_BACKBLAZE_REF=

# --- Live chat (Tawk.to free tier) ---
# When BOTH set, the chat widget loads on every page AFTER marketing-consent
# is granted in the cookie banner. When unset, no chat code ships at all
# (the visitor sees the contact form / phone number as the fallback).
# Find the IDs in https://dashboard.tawk.to → Administration → Channels →
# Chat Widget → Direct Chat Link. The URL ends in /<property>/<widget>.
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=

# --- Leadgen discovery (Overture Maps primary, OpenStreetMap fallback) ---
# Open public-business dataset. Defaults track a tested Overture release; override
# only when intentionally validating a newer release. No API key required.
OVERTURE_RELEASE=2026-06-17.0
# OVERTURE_PLACES_PMTILES_URL=https://.../places.pmtiles
LEADGEN_OVERTURE_MIN_CONFIDENCE=0.5
LEADGEN_OVERTURE_MAX_TILES=36
LEADGEN_OVERTURE_SUFFICIENT_ROWS=12
LEADGEN_CACHE_MIN_ROWS=20
LEADGEN_CACHE_MAX_AGE_MS=86400000

# --- Google Business Profile reviews ---
# Server-side only — DO NOT prefix with VITE_. The /api/reviews endpoint
# proxies Place Details with this key so the homepage shows live Google
# review text + the star rating without shipping the Google Maps JS SDK.
# Quota: 6h edge cache + 24h SWR means roughly 4 calls per day.
# Get a key at https://console.cloud.google.com/google/maps-apis (enable
# "Places API"). Get your Place ID at
# https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Google AdSense (optional, enables ad slots + auto-ads) ---
# Publisher-side client ID in the "ca-pub-1234567890123456" format from
# the AdSense dashboard. src/components/AdSense.jsx uses it to load the
# pagead script + render AdUnit slots placed in blog posts and the blog
# index. Consent-gated: ads only render when the visitor accepts
# marketing cookies via the consent banner. When unset, AdUnit returns
# null (nothing rendered), so it's safe to leave blank until approval
# completes.
#
# Also remember to:
#   1. Replace `ca-pub-XXXXXXXXXXXXXXXX` in index.html's
#      <meta name="google-adsense-account"> with your publisher ID.
#   2. Replace `pub-XXXXXXXXXXXXXXXX` in public/ads.txt.
#   3. After deploy, verify the site in the AdSense dashboard (usually
#      takes 24-48 hours after ads.txt propagates).
VITE_ADSENSE_CLIENT=

# AdSense ad-unit slot IDs (10-digit numeric, NOT prefixed with "ca-pub-").
# Find these in AdSense dashboard → Ads → By ad unit → click the ad unit
# → "Slot ID" line in the embed snippet. Without these set, AdUnit returns
# null and no ads render at all (this is the fix for the silent-no-ad bug
# where empty data-ad-slot="" tags were rendered but AdSense couldn't fill
# them). Two ad units to create in the dashboard:
#   • In-article (display ad, responsive) → VITE_ADSENSE_SLOT_IN_ARTICLE
#   • In-feed (multiplex / native, fluid)  → VITE_ADSENSE_SLOT_IN_FEED
VITE_ADSENSE_SLOT_IN_ARTICLE=
VITE_ADSENSE_SLOT_IN_FEED=

# --- Google Analytics 4 (optional override) ---
# Measurement ID for GA4. public/ga-init.js has a hardcoded fallback
# so tracking works even when this is unset; set it here to point
# staging/dev at a test property without touching code. Consent Mode
# v2 is wired in src/lib/analytics.js — GA runs in cookieless-ping mode
# until the visitor opts in via the cookie banner.
VITE_GA_MEASUREMENT_ID=

# --- Microsoft Clarity (heatmaps + session recordings, optional) ---
# 10-character project ID from clarity.microsoft.com → Settings → Setup.
# Empty = feature disabled (script never injects). Clarity loads only
# after the visitor grants analytics consent — same gate as GA4.
# Free tier covers unlimited sessions; no card on file.
VITE_CLARITY_PROJECT_ID=

# --- Sentry (client-side error tracking, optional) ---
# Public DSN for the browser SDK. When unset, Sentry is a complete no-op —
# no network calls, no warnings, safe to leave blank in development.
# Production DOES log a one-time console.info nudge so the operator
# knows error tracking and the leadgen conversion pipeline are silent.
#
# Setup (free tier: 5,000 events/month, 30-day retention):
#   1. Sign up at https://sentry.io (free "Developer" plan, no card)
#   2. Create a project → pick "JavaScript" / "React" platform
#   3. Project → Settings → Client Keys (DSN) → copy the DSN URL
#      (it looks like https://abc123@o0.ingest.sentry.io/456)
#   4. Paste it below (or in Vercel env: simpleitsrq-com → Settings →
#      Environment Variables → VITE_SENTRY_DSN = the same value)
#   5. Redeploy. The init function in src/lib/sentry.js will pick it up
#      automatically. The next time a trackEvent("generate_lead", ...)
#      fires or an unhandled error happens, it will show up in Sentry.
#
# Dashboard: https://sentry.io → Project → Issues
# The VITE_ prefix exposes it to the client bundle; DSNs are designed to
# be public (they identify the project, not authenticate writes).
VITE_SENTRY_DSN=

# Enable only after AdSense approval; false uses first-party blog banners.
VITE_ADSENSE_ENABLED=false

# =====================================================================
#   ADDITIONAL ENV VARS (used in code, previously undocumented)
#   Names + one-line comments only — NEVER values.
#   Grouped by service. Mark [SENSITIVE] where the value is a secret.
# =====================================================================

# --- GitHub content publishing (repo targeting) ---
# Repo the blog/ops cron commits drafts to (e.g. "simpleitsrq/simpleitsrq-web").
GITHUB_REPO=
# Branch the blog/ops cron commits drafts to (defaults to main when unset).
GITHUB_BRANCH=

# --- Admin API ---
# [SENSITIVE] Bearer token for admin-only portal actions (x-admin-token header).
ADMIN_API_TOKEN=

# --- Anthropic (security analysis) ---
# Model name for the daily security-analysis cron (e.g. claude-sonnet-4-5).
ANTHROPIC_MODEL=

# --- Google Maps (leadgen discovery) ---
# [SENSITIVE] Server-side key for Google Places Text Search leadgen discovery.
GOOGLE_MAPS_API_KEY=

# --- Google Ads (conversion tracking) ---
# Google Ads conversion ID for the analytics layer (public VITE_ var).
VITE_GADS_CONVERSION_ID=

# --- Stripe (leadgen) ---
# Public emergency-support payment link shown on the leadgen page.
VITE_STRIPE_EMERGENCY_SUPPORT_URL=
# [SENSITIVE] Stripe API key used by scripts/stripe-leadgen-setup.mjs.
STRIPE_API_KEY=

# --- Analytics (local tracking toggle) ---
# Set "true" to enable local-only tracking in the analytics layer.
VITE_ENABLE_LOCAL_TRACKING=

# --- Product kits (Stack page buy links) ---
# Public Stripe/checkout buy URLs for the six product kits on /stack.
VITE_PRODUCT_BUNDLE_BUY_URL=
VITE_PRODUCT_HIPAA_KIT_BUY_URL=
VITE_PRODUCT_HURRICANE_KIT_BUY_URL=
VITE_PRODUCT_INSURANCE_KIT_BUY_URL=
VITE_PRODUCT_ONBOARDING_KIT_BUY_URL=
VITE_PRODUCT_WISP_BUY_URL=

# --- IP intelligence (AbuseIPDB + IPinfo) ---
# [SENSITIVE] AbuseIPDB API key for IP reputation lookups.
ABUSEIPDB_API_KEY=
# [SENSITIVE] IPinfo token for IP geolocation/intel.
IPINFO_TOKEN=

# --- Middleware (IP allowlist) ---
# Comma-separated IPs allowed past the middleware IP gate (empty = allow all).
IP_ALLOWLIST=

# --- Honeypot (hostile-traffic canary) ---
# [SENSITIVE] HMAC pepper used to sign the honeypot page challenge.
HP_PW_PEPPER=

# --- Integrations encryption ---
# [SENSITIVE] Key used to encrypt stored integration credentials at rest.
INTEGRATIONS_ENC_KEY=

# --- Brevo (leadgen email sync) ---
# [SENSITIVE] Brevo API key for leadgen email/SMTP sync.
BREVO_API_KEY=

# --- SMTP (leadgen campaign sending) ---
# [SENSITIVE] SMTP host for leadgen campaign email.
SMTP_HOST=
# [SENSITIVE] SMTP password for leadgen campaign email.
SMTP_PASS=
# SMTP port for leadgen campaign email (default 587).
SMTP_PORT=
# [SENSITIVE] SMTP username for leadgen campaign email.
SMTP_USER=
# SMTP connection security: "true" for TLS, "false" for plain (default true).
SMTP_SECURE=
# Physical business address appended to leadgen campaign footers.
LEADGEN_PHYSICAL_ADDRESS=
# Public base URL used in leadgen campaign links.
LEADGEN_PUBLIC_BASE_URL=
# Default From address for leadgen campaign email.
LEADGEN_SMTP_FROM_DEFAULT=

# --- Leadgen crawler / OSM discovery ---
# User-Agent sent by the leadgen email crawler and OSM fetcher.
LEADGEN_USER_AGENT=
# Retry delay (ms) between Overpass API retries.
LEADGEN_OVERPASS_RETRY_DELAY_MS=
# Area threshold (sq deg) above which Overpass queries are split.
LEADGEN_OVERPASS_SPLIT_AREA_THRESHOLD=
# Overpass API request timeout (ms).
LEADGEN_OVERPASS_TIMEOUT_MS=

# --- Leadgen worker (local + serverless queue drain) ---
# Max jobs drained per worker run.
LEADGEN_MAX_JOBS_PER_RUN=
# Time budget (ms) for a single worker run.
LEADGEN_TIME_BUDGET_MS=
# Max passes for the local leadgen worker (scripts/leadgen-worker.mjs).
LEADGEN_MAX_PASSES=
# Watch interval (ms) for the local leadgen worker in --watch mode.
LEADGEN_WATCH_INTERVAL_MS=

# --- Leadgen cron (agent) ---
# Daily budget for leadgen campaign sends.
LEADGEN_SEND_BUDGET=
# Time budget (ms) for leadgen sends per cron run.
LEADGEN_SEND_TIME_BUDGET_MS=

# --- eBay (affiliate product ingestion) ---
# [SENSITIVE] eBay Browse API application ID.
EBAY_APP_ID=
# [SENSITIVE] eBay Browse API certificate ID.
EBAY_CERT_ID=

# --- Neon (ops console) ---
# [SENSITIVE] Neon API key used by the ops console for project management.
NEON_API_KEY=
# Neon project ID used by the ops console.
NEON_PROJECT_ID=

# --- Leadgen portal ---
# Base URL the leadgen portal uses to build self-referencing links.
SELF_BASE_URL=

# --- Google review requests ---
# Public Google review URL used by the review-request cron.
GOOGLE_REVIEW_URL=

# --- Local blog cron (Windows scheduled task) ---
# Hour (0-23) the local blog daemon runs.
BLOG_CRON_HOUR=
# Minute (0-59) the local blog daemon runs.
BLOG_CRON_MINUTE=

# --- Local blog publisher (Gemini/Ollama pipeline) ---
# Slop-gate threshold (0-10) below which a draft is rejected.
BLOG_SLOP_THRESHOLD=
# Minimum Hacker News score for a story to be considered for a draft.
HN_MIN_SCORE=
# Number of top Hacker News stories to consider per run.
HN_TOP_N=
# LLM backend for the local publisher: "gemini" or "ollama".
LLM_BACKEND=
# Ollama model used as the local blog writer.
LOCAL_LLM_WRITER=
# Ollama model used as the local blog critic.
LOCAL_LLM_CRITIC=
# Max revision rounds the critic may request before accepting a draft.
LOCAL_LLM_MAX_REVISIONS=
# Ollama server URL (default http://127.0.0.1:11434).
OLLAMA_URL=
# [SENSITIVE] Gemini API key used when LLM_BACKEND=gemini.
GEMINI_API_KEY=
# Gemini base URL override (for proxies/gateways).
GEMINI_BASE_URL=

# --- UI audit script ---
# Base URL the ui-audit script scans.
UI_AUDIT_BASE_URL=
# Output directory for ui-audit reports.
UI_AUDIT_OUT_DIR=

# --- Resend (from-domain) ---
# Verified sending domain used as the From domain for Resend email.
RESEND_FROM_DOMAIN=

# --- OAuth (auth strategy) ---
# OAuth strategy selector used by the OAuth helper (e.g. "google").
AUTH=
