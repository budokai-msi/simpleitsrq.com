{
  "name": "simpleitsrq-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "publish:local": "node --env-file=.env.local scripts/local-publisher.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-posts-meta.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-rss.mjs && node scripts/generate-og-images.mjs && node scripts/generate-city-og-images.mjs && node scripts/generate-industry-og-images.mjs",
    "build": "vite build && node scripts/generate-blog-stubs.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci:install": "npm ci",
    "generate:images": "node scripts/generate-images.mjs",
    "benchmark:scan": "node scripts/benchmark/run-batch-scan.mjs",
    "benchmark:report": "node scripts/benchmark/generate-report.mjs",
    "db:push": "node --env-file=.env.local scripts/db/push.mjs",
    "leadgen:work": "node --env-file=.env.local scripts/leadgen-worker.mjs",
    "leadgen:watch": "node --env-file=.env.local scripts/leadgen-worker.mjs --watch",
    "blog:daemon": "node --env-file=.env.local scripts/local-cron-daemon.mjs",
    "blog:once": "node --env-file=.env.local scripts/local-cron-daemon.mjs --once"
  },
  "dependencies": {
    "@mapbox/vector-tile": "2.0.4",
    "@neondatabase/serverless": "1.1.0",
    "@sentry/react": "10.71.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "botid": "1.5.11",
    "cheerio": "1.2.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "imapflow": "^1.6.5",
    "jose": "6.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "1.34.0",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "pbf": "4.0.1",
    "pmtiles": "4.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.2",
    "recharts": "^3.10.1",
    "resend": "6.17.1",
    "stripe": "22.3.0",
    "unist-util-visit": "^5.1.0",
    "web-vitals": "^6.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "gray-matter": "4.0.3",
    "remark-frontmatter": "5.0.0",
    "remark-mdx-frontmatter": "5.2.0",
    "sharp": "0.35.3",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "3.15.1",
    "svix": "1.92.2",
    "nanoid": "3.3.18",
    "html-to-text": "10.0.1",
    "deepmerge-ts": "8.0.2"
  }
}
